# syntax=docker/dockerfile:1

# Fast local dev image: deps install on first start into named volumes, then `next dev`.
FROM node:22-alpine
WORKDIR /repo
RUN apk add --no-cache su-exec
ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
ENV NEXT_TELEMETRY_DISABLED=1
RUN corepack enable && corepack prepare pnpm@10.33.3 --activate
COPY apps/web/nextjs/docker-dev-entrypoint.sh /usr/local/bin/docker-dev-entrypoint.sh
COPY apps/web/nextjs/docker-dev-init.sh /usr/local/bin/docker-dev-init.sh
RUN chmod +x /usr/local/bin/docker-dev-entrypoint.sh /usr/local/bin/docker-dev-init.sh
EXPOSE 3000
ENTRYPOINT ["docker-dev-init.sh"]
