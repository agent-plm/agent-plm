COMPOSE_PROJECT_NAME=agent-plm

# Database
PLM_DB_USER=plm
PLM_DB_PASSWORD=plm
PLM_DB_NAME=plm
PLM_DB_PORT=5432
PLM_DB_URL=jdbc:postgresql://localhost:5432/plm

# Object storage (RustFS)
PLM_S3_ACCESS_KEY=rustfsadmin
PLM_S3_SECRET_KEY=rustfsadmin
PLM_S3_PORT=9000
PLM_S3_CONSOLE_PORT=9001
PLM_S3_ENDPOINT=http://localhost:9000
PLM_S3_BUCKET=plm

# Cache (Valkey) — never authoritative
PLM_REDIS_PORT=6379
PLM_REDIS_URL=redis://localhost:6379

# AuthN / AuthZ
PLM_AUTHELIA_PORT=9091
PLM_OIDC_ISSUER=https://plm.lvh.me:9091
PLM_CERBOS_HTTP_PORT=3592
PLM_CERBOS_GRPC_PORT=3593
PLM_CERBOS_URL=http://localhost:3592

# Applications
PLM_API_PORT=8080
PLM_WEB_PORT=3000
PLM_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
PLM_PUBLIC_URL=http://localhost:3000

# AI (unused in Phase 1)
PLM_AI_PROVIDER=
PLM_AI_API_KEY=
PLM_EMBEDDING_PROVIDER=

# Observability
PLM_OTEL_SDK_DISABLED=true
